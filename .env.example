# 变大泡泡 · 环境变量模板
# 复制本文件为 .env 并填写；服务器上 chmod 600 .env
# key 只在服务端，不进代码仓库、不进前端

# 你的模型 API key（填这里）
AI_API_KEY=

# 百炼兼容 OpenAI 接口
AI_STYLE=openai

# 百炼兼容模式地址与模型名
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_MODEL=qwen3.8-max

# 熔断与限流（公开链接防烧钱）
AI_DAILY_LIMIT=300
AI_PER_HOUR=20

PORT=3000
