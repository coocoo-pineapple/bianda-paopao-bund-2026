{
  "name": "bianda-paopao",
  "version": "0.1.0",
  "private": true,
  "description": "变大泡泡 · 伪装成办公软件的跨公司匿名职场社区",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:secret": "wrangler secret put AI_API_KEY",
    "cf:media": "wrangler r2 object put bianda-paopao-media/media/宣传片.mp4 --file public/media/宣传片.mp4 --content-type video/mp4 --remote",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
}
